# --- Database ---
# Local PostgreSQL (asyncpg driver). Example for a database called "mindsync":
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@127.0.0.1:5432/mindsync

# --- Auth / Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Trained task-fit model (see docs/ML_MODEL.md). The wellbeing model needs no setting. ---
# Set ML_ENABLED=false to use the plain heuristic only.
ML_ENABLED=true
# Share of the final score that comes from the trained model (0 to 1)
ML_WEIGHT=0.3

# --- Email deadline alerts (see docs/EMAIL_ALERTS.md) ---
# Leave SMTP_HOST blank to run without a mail server: alert emails are then saved as .eml files in backend/outbox.
REMINDERS_ENABLED=true
REMINDER_HOURS_BEFORE=48
REMINDER_CHECK_MINUTES=15
# Real email example (Gmail App password; see docs/EMAIL_ALERTS.md). Type YOUR values into backend/.env only, never into this file.
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=youraddress@gmail.com
# SMTP_PASSWORD=your-16-letter-app-password
# SMTP_FROM=youraddress@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
APP_URL=http://localhost:5173

# --- Language-model assistant and AI Learning Studio (see docs/AI_ACTIVATION_GUIDE.md) ---
# AI is OFF. Nothing calls any AI service until YOU choose a provider here AND add its key.
# To switch on the free Google Gemini plan later:  AI_PROVIDER=gemini  and  GEMINI_API_KEY=<your key from Google AI Studio>.
# Type keys into backend/.env ONLY (never into this example file, never into the website code, never into chat).
# Check the model name and the free limits for your account in Google AI Studio first; they change.
# Free-tier warning: Google may use free-tier content to improve its products. Do not upload private or sensitive material.
AI_PROVIDER=off
GEMINI_API_KEY=
# Recommended free model (Google pricing page, 30 Oct 2026): free tokens, light thinking by default, the largest free daily allowance of the Flash models. Check your own free allowance in Google AI Studio.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_PRICE_IN_PER_M=0
GEMINI_PRICE_OUT_PER_M=0
# Free Gemini costs nothing. Fill in real prices (from Google's pricing page) only if you move to a paid plan, so the monthly budget limit stays accurate.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# gpt-6-luna reasons at "medium" by default (slower, and billed). MindSync only extracts and words things, so it asks for "none". Leave blank to send nothing.
AI_REASONING_EFFORT=none
AI_TOTAL_DEADLINE_SECONDS=10
AI_TIMEOUT_SECONDS=8
AI_USER_DAILY_CALLS=40
AI_MONTHLY_BUDGET_USD=5
AI_PRICE_IN_PER_M=0.10
AI_PRICE_OUT_PER_M=0.50
# Guests use the rules unless you set this to true.
AI_ALLOW_GUESTS=false

# --- Learning Studio limits (checked on the server; students cannot change them) ---
STUDIO_MAX_CHARS=24000
STUDIO_MAX_UPLOAD_MB=5
STUDIO_MAX_PDF_PAGES=80
STUDIO_TIMEOUT_SECONDS=75
STUDIO_USER_DAILY_ATTEMPTS=5
STUDIO_USER_MONTHLY_ATTEMPTS=20
STUDIO_GLOBAL_DAILY_ATTEMPTS=40
STUDIO_COOLDOWN_SECONDS=45
STUDIO_MAX_PACKS_PER_USER=30
